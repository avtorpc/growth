{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {"growth": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {"builder": "@angular/build:application", "options": {
        "browser": "src/main.ts", "tsConfig": "tsconfig.json", "index": "src/index.html",
        "styles": ["src/styles.css"], "outputPath": "dist/growth"
      }},
      "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "growth:build"}}
    }
  }},
  "cli": {"analytics": false}
}
